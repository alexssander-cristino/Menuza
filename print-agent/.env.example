# Impressora instalada no Windows (USB ou compartilhada pelo driver)
PRINTER_TYPE=windows
# Opcional: nome exato exibido em Configurações > Impressoras
PRINTER_NAME=

# OU impressora térmica de rede com ESC/POS na porta 9100
# PRINTER_TYPE=network
# PRINTER_HOST=192.168.1.150
# PRINTER_PORT=9100

PRINT_AGENT_PORT=17891
# Adicione a origem do seu domínio Menuza se for diferente:
ALLOWED_ORIGINS=https://menuza-five.vercel.app,http://localhost:4173
