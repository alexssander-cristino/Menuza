# Impressora Epson via driver do Windows/USB:
PRINTER_TYPE=epson-usb
PRINTER_NAME=
# Modelos: auto, tm-t20, tm-t88, tm-m30, tm-u220
EPSON_MODEL=auto
# Corte automático (modo ESC/POS de rede)
EPSON_CUT=true

# Para Epson Ethernet/Wi-Fi compatível com ESC/POS, use em vez do modo USB:
# PRINTER_TYPE=epson-network
# PRINTER_HOST=192.168.0.100
# PRINTER_PORT=9100

PRINT_AGENT_PORT=17891
# Inclua aqui a URL exata do painel Menuza, separada por vírgulas:
ALLOWED_ORIGINS=https://menuza-five.vercel.app,http://localhost:4173,http://127.0.0.1:4173
