{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "^/api/(?!dispatch$|health$)(.*)$",
      "dest": "/api/dispatch?path=$1"
    }
  ],
  "cleanUrls": false
}
